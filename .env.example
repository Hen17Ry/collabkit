# Adresse publique du site (sert aux liens envoyés par email)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Prix du media kit, en FCFA : prix normal, et prix de lancement jusqu'à la date indiquée
NUXT_PUBLIC_PRICE_FCFA=5000
NUXT_PUBLIC_PROMO_PRICE_FCFA=3500
# Montants facturés en dollars US par Moneroo (normal et lancement)
NUXT_PUBLIC_PRICE_USD=9
NUXT_PUBLIC_PROMO_PRICE_USD=6
NUXT_PUBLIC_PROMO_UNTIL=2027-01-01T00:00:00+01:00

# Moneroo — tableau de bord > Développeurs > Clés API (clé secrète sandbox pour tester, puis clé de production)
NUXT_MONEROO_SECRET_KEY=
# Secret de signature choisi dans Moneroo > Développeurs > Webhooks (URL : https://ton-site/api/moneroo/webhook)
NUXT_MONEROO_WEBHOOK_SECRET=
# true si Moneroo attend les montants en centimes (6 $ = 600)
NUXT_MONEROO_MINOR_UNITS=false

# Emails par SMTP. Gmail : smtp.gmail.com, port 465, et un « mot de passe d'application »
# (compte Google > Sécurité > Validation en deux étapes > Mots de passe des applications)
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# Facultatif : nom et adresse d'expédition (par défaut « Ton Media Kit <NUXT_SMTP_USER> »)
NUXT_MAIL_FROM=

# Stockage en production (Vercel) : base Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Développement uniquement : simule le paiement pour tester le parcours sans Moneroo
NUXT_PUBLIC_FAKE_PAYMENT=false
