# Adresse publique du site (sert aux liens envoyés par email)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Prix du media kit, en FCFA
NUXT_PUBLIC_PRICE_FCFA=2500

# KKiaPay — tableau de bord > Développeurs > Clés API
NUXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
NUXT_PUBLIC_KKIAPAY_SANDBOX=true
NUXT_KKIAPAY_PRIVATE_KEY=
NUXT_KKIAPAY_SECRET_KEY=
# Secret défini dans KKiaPay > Webhooks (en-tête x-kkiapay-secret)
NUXT_KKIAPAY_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys (domaine vérifié requis pour envoyer à tout le monde)
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM="Collab Kit <bonjour@ton-domaine.com>"

# Stockage en production (Vercel) : base Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Développement uniquement : simule le paiement pour tester le parcours sans KKiaPay
NUXT_PUBLIC_FAKE_PAYMENT=false
